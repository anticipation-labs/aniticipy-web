# Anticipy website — every environment variable src/ reads.
#
# NAMES ONLY. Never put a value in this file: it is committed and the repo is
# public. Copy it to .env.local (gitignored) and fill that in for local dev;
# production values live on the Vercel project.
#
# Generated from the source, not by hand:
#   grep -rhoE 'process\.env\.[A-Z0-9_]+' src/ | sed 's/process\.env\.//' | sort -u
# so it cannot drift from what the code actually asks for.
#
# The old monorepo had NO .env.example at all, which is why 10 variables were
# set on Vercel against the 77 below -- there was nothing to check against.

# ── Required: the site will not build without these ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gate + signing secrets. Unset means a random per-process key: unforgeable,
#    but sessions and confirm links die on every redeploy. openssl rand -hex 32
JWT_SECRET=
GATE_COOKIE_SECRET=
ANALYTICS_SECRET=

# ── CRON_SECRET is a special case: authorize() ends `return !secret;`, so
#    LEAVING IT UNSET MAKES /api/cron/daily-digest WORLD-TRIGGERABLE, and that
#    route sends email. Set it.
CRON_SECRET=
# Do NOT set NEXT_PUBLIC_CRON_SECRET to the same value: NEXT_PUBLIC_* is
# inlined into the browser bundle, which publishes the cron secret.
NEXT_PUBLIC_CRON_SECRET=

# ── Everything else src/ reads ──
ADMIN_EMAIL=
ADMIN_EMAIL_NOTIFICATIONS=
AGENT_LOG_SECRET=
ANALYTICS_PASSWORD=
ANTICIPY_FEW_SHOT_BLOCK=
ANTICIPY_NOTIFY_EMAIL_PROVIDER=
ANTICIPY_NOTIFY_FROM_ALLOWLIST=
ANTICIPY_NOTIFY_FROM_EMAIL=
